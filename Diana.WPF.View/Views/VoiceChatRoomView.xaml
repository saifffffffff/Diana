<Window x:Class="Diana.WPF.View.Views.VoiceChatRoomView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Diana.WPF.View.Controls"
        mc:Ignorable="d"
        Title="Voice Chat" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Closed="Window_Closed"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ControlBarButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Background="#0D1117" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8">
        <Grid Background="#0D1117" Loaded="Grid_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <!-- Custom title bar -->
                <RowDefinition Height="64"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Members area -->
                <RowDefinition Height="Auto"/>
                <!-- Self-status bar -->
                <RowDefinition Height="76"/>
                <!-- Control bar -->
            </Grid.RowDefinitions>

            <!-- ═══════════════ CUSTOM TITLE BAR ═══════════════ -->
            <Border Grid.Row="0" Background="#0D1117"
                    BorderBrush="#2D3748" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="  Diana — Voice Chat"
                               Foreground="#8892A4" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Width="34" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8892A4" FontSize="14"
                                Cursor="Hand" Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <TextBlock Text="─" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="34" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8892A4" FontSize="10"
                                Cursor="Hand" Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <TextBlock Text="□" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="34" Height="24"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#8892A4" FontSize="14"
                                Cursor="Hand" Click="CloseButton_Click"
                                ToolTip="Close">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ HEADER ═══════════════ -->
            <Border Grid.Row="1" Background="#161B22"
                    BorderBrush="#2D3748" BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#10B981" Margin="0,0,14,0">
                        <TextBlock Text="🎤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="RoomNameText" Text="Voice Room"
                                   Foreground="#E2E8F0" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="MemberCountText" Text="0 members"
                                   Foreground="#8892A4" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyKeyButton"
                                Width="34" Height="34"
                                Background="{StaticResource ButtonSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Copy Room Key"
                                Click="CopyKeyButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="📋" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ MEMBERS GRID ═══════════════ -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,16,20,8"
                          Background="{StaticResource Background}">
                <ItemsControl x:Name="MembersContainer">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:VoiceRoomMemberTile
                                Username="{Binding Username}"
                                Initials="{Binding Initials}"
                                ImageBase64="{Binding ImageBase64}"
                                IsSpeaking="{Binding IsSpeaking}"
                                IsMuted="{Binding IsMuted}"
                                Margin="6,6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ═══════════════ SELF STATUS ═══════════════ -->
            <Border Grid.Row="3" Background="#161B22"
                    BorderBrush="#2D3748" BorderThickness="0,1,0,0"
                    Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                            Background="#21283A" BorderBrush="#2D3748" BorderThickness="1"
                            Margin="0,0,10,0">
                        <TextBlock x:Name="SelfInitials" Text="?" 
                                   Foreground="#E2E8F0" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SelfUsernameText" Text="{Binding Username, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Voice Connected" Foreground="#10B981" FontSize="11"/>
                    </StackPanel>

                    <Border x:Name="SelfMicStatus" Grid.Column="2"
                            Background="#21283A" CornerRadius="6"
                            Padding="8,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelfMicIcon" Text="🎤" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelfMicLabel" Text="Mute" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════ CONTROL BAR ═══════════════ -->
            <Border Grid.Row="4" Background="#0D1117"
                    BorderBrush="#2D3748" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="MicButton" Grid.Column="0"
                            Style="{StaticResource SecondaryButton}"
                            Click="MicButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="MicIcon" Text="🎤" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MicLabel" Text="Mute" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsButton" Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Click="SettingsButton_Click">
                        <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center"/>
                    </Button>

                    <Button x:Name="LeaveButton" Grid.Column="4"
                            Style="{StaticResource DangerButton}"
                            Click="LeaveButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📞" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Leave" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>