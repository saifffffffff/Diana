<UserControl x:Class="Diana.WPF.View.Controls.VoiceRoomMemberTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="168" Height="176"
             Background="Transparent"
             RenderOptions.BitmapScalingMode="HighQuality">
    <Grid>
        <!-- Background card -->
        <Border x:Name="CardBorder" 
                Background="#1C2333" 
                CornerRadius="10"
                BorderBrush="#2D3748" 
                BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Avatar section -->
                <Border Grid.Row="0" 
                        Background="#21283A" 
                        CornerRadius="10,10,0,0"
                        BorderThickness="0">
                    <Grid>
                        <!-- Avatar image (from base64) -->
                        <Ellipse x:Name="AvatarImage" 
                                 Width="72" Height="72"
                                 StrokeThickness="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Default initials fallback -->
                        <Border x:Name="DefaultAvatar" 
                                Width="72" Height="72" 
                                CornerRadius="36"
                                Background="#2D3748"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderThickness="0">
                            <TextBlock x:Name="InitialsText" 
                                       Text="?" 
                                       Foreground="#E2E8F0" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Speaking green glow border -->
                        <Ellipse x:Name="SpeakingGlow" 
                                 Width="80" Height="80"
                                 Stroke="#10B981" 
                                 StrokeThickness="2"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <!-- Muted mic icon (bottom-right) -->
                        <Border x:Name="MuteBadge" 
                                Width="28" Height="28" 
                                CornerRadius="8"
                                Background="#2D1B1B"
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,8"
                                Visibility="Collapsed">
                            <TextBlock Text="🔇" FontSize="12" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Speaking dot (bottom-center) -->
                        <Border x:Name="SpeakingBadge" 
                                Width="12" Height="12" 
                                CornerRadius="6"
                                Background="#10B981"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,6"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Name area -->
                <StackPanel Grid.Row="1" Margin="10,8,10,10">
                    <TextBlock x:Name="UsernameText" 
                               Text="Username"
                               Foreground="#E2E8F0" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" 
                               Text="Voice connected"
                               Foreground="#8892A4" 
                               FontSize="11"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>